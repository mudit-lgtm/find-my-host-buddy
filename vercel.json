{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "site-host-finder.vercel.app" }],
      "destination": "https://sitehostfinder.online/:path*",
      "statusCode": 301
    },
    { "source": "/go/hostinger", "destination": "https://www.hostinger.com/in?REFERRALCODE=YIIMADRASPUW", "statusCode": 302 },
    { "source": "/tools/hosting-checker", "destination": "/", "statusCode": 301 },
    { "source": "/tools/hosting-lookup", "destination": "/", "statusCode": 301 },
    { "source": "/tools/find-website-host", "destination": "/", "statusCode": 301 },
    { "source": "/tools/where-is-website-hosted", "destination": "/", "statusCode": 301 },
    { "source": "/tools/who-is-hosting", "destination": "/", "statusCode": 301 },
    { "source": "/privacy-policy", "destination": "/privacy", "statusCode": 301 },
    { "source": "/terms-of-service", "destination": "/terms", "statusCode": 301 }
  ],
  "rewrites": [
    { "source": "/results/(.*)", "destination": "/index.html" },
    { "source": "/((?!.*\\.).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/sitemap.xml", "headers": [{ "key": "Content-Type", "value": "application/xml" }] },
    { "source": "/robots.txt", "headers": [{ "key": "Content-Type", "value": "text/plain" }] },
    {
      "source": "/tools/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/guides/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
