{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/go/hostinger",
      "destination": "https://www.hostinger.com/in?REFERRALCODE=YIIMADRASPUW",
      "statusCode": 302
    }
  ],
  "rewrites": [
    { "source": "/((?!.*\\.).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml" }]
    }
  ]
}
